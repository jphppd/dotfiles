[alias]
  st = status --branch --short
  ls = status --short --untracked-files=no
  df = diff
  dc = diff --cached
  wdf = diff --word-diff=color --unified=1
  wdc = diff --word-diff=color --unified=1 --cached
  g = grep --break --heading --line-number
  h = reflog --date=iso

  lg = lg1
  lg1 = lg-fmt-1 --graph --topo-order --abbrev-commit --decorate=full --all
  lg2 = lg-fmt-2 --graph --topo-order --abbrev-commit --decorate=full --all --stat
  lg-no-graph = lg-fmt-1 --abbrev-commit --decorate=full

  lg-fmt-1 = log --format=format:'%Cred%h%Creset %Cgreen(%ar)%Creset%C(auto)%d%Creset %C(bold)%s%Creset %Cblue%C(bold)%an%Creset'
  lg-fmt-2 = log --format=format:'─┬─ %Cred%h%Creset %Cgreen(%aI, %ar)%Creset%C(auto)%d%Creset%n └─ %C(bold)%s%Creset %Cblue%C(bold)%an%Creset%n'

  sdiff = !git diff && git submodule foreach 'git diff'
  spush = push --recurse-submodules=on-demand
  supdate = submodule update --remote --rebase

[branch]
  autoSetupRebase = always
  sort = -committerdate

[commit]
  verbose = true

[core]
  autocrlf = input
  pager = less --quit-if-one-screen --RAW-CONTROL-CHARS --no-init --chop-long-lines

[diff]
  algorithm = histogram
  colorMoved = default

[fetch]
  prune = true

[include]
# Per-machine settings (name, e-mail, signing key, credential helper, ...) live
# in this untracked file; see credentials.template
  path = ~/.config/git/credentials

[init]
  defaultBranch = main

[merge]
  conflictstyle = zdiff3
  tool = vimdiff
  ff = only

[pull]
  rebase = true

[push]
  autoSetupRemote = true
  followTags = true

[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true

[rerere]
  enabled = true
  autoupdate = true

[status]
  submodulesummary = 1

[tag]
  sort = version:refname

[user]
# Refuse to commit when no identity is configured, instead of guessing
# user@hostname on a machine where the credentials file is missing
  useConfigOnly = true
